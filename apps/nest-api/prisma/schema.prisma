generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum MerchantStatus {
  ACTIVE
  DRAFT
}

enum StoreStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum TaskStatus {
  CREATED
  QUEUED
  THINKING
  PLANNING
  EXECUTING
  RENDERING
  INSPECTING
  REPAIRING
  VERIFYING
  AWAITING_APPROVAL
  COMPLETED
  NEEDS_REVIEW
  FAILED
  BLOCKED
  CANCELLED
}

enum MemoryType {
  PREFERENCE
  DECISION
  CONSTRAINT
  FACT
  FEEDBACK
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WorkspaceStatus {
  PROVISIONING
  READY
  FAILED
  ARCHIVED
}

enum CommerceRecordType {
  SERVICE
  APPOINTMENT
  ORDER
  QUOTE
  INVENTORY
  CUSTOMER
  FULFILLMENT
  SERVICE_CASE
  PRODUCTION
  TABLE
  MENU_ITEM
  SUBSCRIPTION
}

model Merchant {
  id        String @id
  name      String
  slug      String @unique
  status    MerchantStatus @default(DRAFT)
  createdAt DateTime @default(now())
  users     User[]
  stores    Store[]
  tasks     Task[]
  memories  Memory[]
  conversations Conversation[]
  workspaces Workspace[]
  commerceRecords CommerceRecord[]
}

model User {
  id         String @id
  email      String @unique
  name       String
  merchantId String
  role       UserRole @default(MEMBER)
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model Store {
  id           String @id
  merchantId   String
  name         String
  slug         String
  status       StoreStatus @default(DRAFT)
  brandName    String
  brandPalette Json
  brandTone    String
  themeMode    String
  themeAccent  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  products     Product[]
  collections  Collection[]
  conversations Conversation[]
  tasks        Task[]
  memories     Memory[]
  previews     Preview[]
  workspace    Workspace?
  commerceRecords CommerceRecord[]
  @@unique([merchantId, slug])
}

model Product {
  id          String @id
  storeId     String
  name        String
  slug        String
  description String @default("")
  price       Int @default(0)
  currency    String @default("USD")
  inventory   Int @default(0)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  store       Store @relation(fields: [storeId], references: [id])
  @@unique([storeId, slug])
}

model Collection {
  id          String @id
  storeId     String
  name        String
  slug        String
  description String @default("")
  createdAt   DateTime @default(now())
  store       Store @relation(fields: [storeId], references: [id])
  @@unique([storeId, slug])
}

model Conversation {
  id        String @id
  merchantId String
  storeId   String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  merchant  Merchant @relation(fields: [merchantId], references: [id])
  store     Store? @relation(fields: [storeId], references: [id])
  messages  Message[]
}

model Message {
  id             String @id
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Task {
  id         String @id
  merchantId String
  storeId    String?
  status     TaskStatus @default(CREATED)
  objective  String
  plan       Json?
  events     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  store      Store? @relation(fields: [storeId], references: [id])
  sessions   AgentSession[]
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  agentRuns AgentRun[]
}

model CommerceRecord {
  id          String @id
  merchantId  String
  storeId     String
  type        CommerceRecordType
  status      String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId, type, status, createdAt])
  @@index([merchantId, type, createdAt])
}

model Workspace {
  id          String @id
  merchantId  String
  storeId     String @unique
  sandboxId   String @unique
  root        String @default("/workspace")
  status      WorkspaceStatus @default(PROVISIONING)
  previewUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tasks       Task[]
  snapshots   WorkspaceSnapshot[]
}

model WorkspaceSnapshot {
  id          String @id
  workspaceId String
  taskId      String?
  revision    Int
  files       Json
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, revision])
  @@index([workspaceId, createdAt])
}

model AgentRun {
  id        String @id
  taskId    String
  flowId    String
  status    String
  state     Json
  createdAt DateTime @default(now())
  startedAt DateTime @default(now())
  finishedAt DateTime?
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  steps     AgentStep[]
  tools     ToolExecution[]
  observations Observation[]
  evaluations Evaluation[]
  @@index([taskId, createdAt])
  @@index([status, startedAt])
}

model AgentStep {
  id        String @id
  runId     String
  taskKey   String
  agentId   String
  status    String
  input     Json?
  output    Json?
  startedAt DateTime
  finishedAt DateTime
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tools     ToolExecution[]
  observations Observation[]
  @@unique([runId, taskKey])
  @@index([runId, startedAt])
}

model ToolExecution {
  id        String @id
  runId     String
  stepId    String?
  toolName  String
  status    String
  input     Json
  output    Json?
  error     String?
  startedAt DateTime
  finishedAt DateTime
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step      AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  @@index([runId, startedAt])
}

model Observation {
  id        String @id
  runId     String
  stepId    String?
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step      AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  @@index([runId, createdAt])
}

model Evaluation {
  id        String @id
  runId     String
  kind      String
  passed    Boolean
  score     Float?
  findings  Json
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId, kind])
}

model Memory {
  id         String @id
  merchantId String
  storeId    String?
  type       MemoryType
  value      String
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  store      Store? @relation(fields: [storeId], references: [id])
}

model ModelUsage {
  id           String @id
  provider     String
  model        String
  task         String
  agent        String
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  latencyMs    Int @default(0)
  estimatedCost Int @default(0)
  createdAt    DateTime @default(now())
}

model Preview {
  id         String @id
  storeId    String
  previewUrl String
  status     String
  updatedAt  DateTime @updatedAt
  store      Store @relation(fields: [storeId], references: [id])
}

model AgentSession {
  id        String @id
  taskId    String
  status    String
  lockedBy  String?
  lockedAt  DateTime?
  state     Json
  updatedAt DateTime @updatedAt
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([status, lockedAt])
}
